# Optional: cloud sync with Supabase.
# Copy this file to ".env" and fill in the two values from your Supabase project
# (Dashboard -> Project Settings -> API). Without them FocusFlow runs in local mode.
#
# Use the anon / publishable key only. Never put the service_role or secret key here:
# the app refuses to start cloud sync with one.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The names SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are accepted too.
# After changing .env, restart "npm run dev" or rebuild with "npm run dist".
